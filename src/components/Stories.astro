---
import type { z } from 'astro/zod';
import type { storiesSchema } from '../lib/schemas';

interface Props {
  stories: z.infer<typeof storiesSchema>;
}

const { stories } = Astro.props;
---
<section class="sec wrap" id="stories" aria-labelledby="st-h">
  <h2 id="st-h">{stories.heading}</h2>
  <p class="lead">{stories.subheading}</p>

  <div class="quotes" role="list">
    {stories.items.map((item) => (
      <figure class="quote" role="listitem">
        <blockquote style="margin:0">
          <p>{item.quote}</p>
        </blockquote>
        <figcaption>
          <b>{item.author}</b>
          <span>{item.trip}, {item.location}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84%, 360px);
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-top: 2.2rem;
    padding-bottom: 0.5rem;
  }

  .quotes::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 900px) {
    .quotes {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      gap: 3rem;
    }
  }

  .quote {
    margin: 0;
    scroll-snap-align: start;
    padding-left: 1.25rem;
    border-left: 3px solid var(--gold);
  }

  .quote p {
    font-size: 1.25rem;
    line-height: 1.45;
    font-stretch: 95%;
    font-weight: 500;
  }

  .quote figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--slate);
  }

  .quote figcaption b {
    display: block;
    color: var(--ink);
    font-size: 1rem;
  }
</style>
