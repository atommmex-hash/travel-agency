---
import type { z } from 'astro/zod';
import type { storiesSchema } from '../lib/schemas';

interface Props {
  stories: z.infer<typeof storiesSchema>;
}

const { stories } = Astro.props;

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---
<section class="sec wrap" id="stories" aria-labelledby="st-h">
  <div class="stories-header">
    <span class="sec-badge">TESTIMONIALS</span>
    <h2 id="st-h">{stories.heading}</h2>
    <div class="rating-strip">
      <span class="stars">⭐⭐⭐⭐⭐</span>
      <span class="rating-text"><strong>4.9 / 5</strong> Based on 1,200+ Verified Mountain Travellers</span>
    </div>
  </div>

  <div class="reviews-grid" role="list">
    {stories.items.map((item, idx) => (
      <div class="review-card" role="listitem">
        <div class="review-top">
          <div class="author-avatar">
            {getInitials(item.author)}
          </div>
          <div class="author-details">
            <b>{item.author}</b>
            <span class="verified-tag">✓ Verified Traveller</span>
          </div>
          <span class="card-stars">★★★★★</span>
        </div>

        <blockquote class="review-quote">
          <p>“{item.quote}”</p>
        </blockquote>

        <div class="review-footer">
          <span class="trip-tag">🏔️ {item.trip}</span>
          <span class="origin-tag">📍 {item.location}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .sec-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-pill);
    margin-bottom: 0.6rem;
    letter-spacing: 0.05em;
  }

  .stories-header {
    margin-bottom: 2.2rem;
  }

  .rating-strip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .stars {
    font-size: 1.1rem;
  }

  .rating-text {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .reviews-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-m);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: #BEE3F8;
  }

  .review-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    font-weight: 900;
    font-size: 1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .author-details b {
    font-size: 1rem;
    color: var(--text-main);
  }

  .verified-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-green);
  }

  .card-stars {
    color: #F6AD55;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
  }

  .review-quote {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-muted);
    font-style: italic;
    flex: 1;
  }

  .review-footer {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
  }

  .trip-tag {
    font-weight: 700;
    color: var(--primary);
  }

  .origin-tag {
    color: var(--text-light);
  }
</style>
