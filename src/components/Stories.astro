---
import type { z } from 'astro/zod';
import type { storiesSchema } from '../lib/schemas';

interface Props {
  stories: z.infer<typeof storiesSchema>;
}

const { stories } = Astro.props;

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---
<section class="sec wrap" id="stories" aria-labelledby="st-h">
  <div class="stories-header">
    <span class="sec-badge">TESTIMONIALS</span>
    <h2 id="st-h">{stories.heading}</h2>
    <div class="rating-strip">
      <div class="stars-row" aria-label="5 stars">
        <svg class="i star-svg" aria-hidden="true"><use href="#i-star"></use></svg>
        <svg class="i star-svg" aria-hidden="true"><use href="#i-star"></use></svg>
        <svg class="i star-svg" aria-hidden="true"><use href="#i-star"></use></svg>
        <svg class="i star-svg" aria-hidden="true"><use href="#i-star"></use></svg>
        <svg class="i star-svg" aria-hidden="true"><use href="#i-star"></use></svg>
      </div>
      <span class="rating-text"><strong>5.0 / 5</strong> Based on 4,500+ Verified Google Reviews</span>
    </div>
  </div>

  <div class="reviews-grid" role="list">
    {stories.items.map((item) => (
      <div class="review-card" role="listitem">
        <div class="review-top">
          <div class="author-avatar">
            {getInitials(item.author)}
          </div>
          <div class="author-details">
            <b>{item.author}</b>
            <span class="verified-tag"><svg class="i mini-check" aria-hidden="true"><use href="#i-check"></use></svg> Verified Traveller</span>
          </div>
          <div class="card-stars" aria-label="5 stars">
            <svg class="i star-mini" aria-hidden="true"><use href="#i-star"></use></svg>
            <svg class="i star-mini" aria-hidden="true"><use href="#i-star"></use></svg>
            <svg class="i star-mini" aria-hidden="true"><use href="#i-star"></use></svg>
            <svg class="i star-mini" aria-hidden="true"><use href="#i-star"></use></svg>
            <svg class="i star-mini" aria-hidden="true"><use href="#i-star"></use></svg>
          </div>
        </div>

        <blockquote class="review-quote">
          <p>“{item.quote}”</p>
        </blockquote>

        <div class="review-footer">
          <span class="trip-tag">
            <svg class="i footer-svg" aria-hidden="true"><use href="#i-mountain"></use></svg>
            <span>{item.trip}</span>
          </span>
          <span class="origin-tag">
            <svg class="i footer-svg" aria-hidden="true"><use href="#i-pin"></use></svg>
            <span>{item.location}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .sec-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--primary);
    background: var(--primary-light);
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-pill);
    margin-bottom: 0.6rem;
    letter-spacing: 0.05em;
  }

  .stories-header {
    margin-bottom: 2.2rem;
  }

  .rating-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .stars-group {
    display: inline-flex;
    gap: 0.2rem;
  }

  .star-svg {
    width: 20px;
    height: 20px;
    color: #FFB400;
    fill: #FFB400;
  }

  .rating-text {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .reviews-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-m);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: #BEE3F8;
  }

  .review-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    font-weight: 900;
    font-size: 1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .author-details b {
    font-size: 1rem;
    color: var(--text-main);
  }

  .verified-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-green);
  }

  .mini-check {
    width: 12px;
    height: 12px;
  }

  .card-stars {
    display: inline-flex;
    gap: 0.15rem;
  }

  .star-mini {
    width: 14px;
    height: 14px;
    color: #FFB400;
    fill: #FFB400;
  }

  .review-quote {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-muted);
    font-style: italic;
    flex: 1;
  }

  .review-footer {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
  }

  .trip-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--primary);
  }

  .origin-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-light);
  }

  .footer-svg {
    width: 14px;
    height: 14px;
    color: currentColor;
  }
</style>
