---
import type { z } from 'astro/zod';
import type { faqSchema } from '../lib/schemas';

interface Props {
  faq: z.infer<typeof faqSchema>;
}

const { faq } = Astro.props;
---
<section class="sec sec-white" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <h2 id="faq-h">{faq.heading}</h2>
    <div class="acc faq-list">
      {faq.items.map((item) => (
        <details>
          <summary>
            <span>{item.question}</span>
            <svg class="i" aria-hidden="true"><use href="#i-chev"></use></svg>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    margin-top: 2rem;
    max-width: 820px;
    border-bottom: 1px solid var(--mist);
  }

  .faq-list details {
    border-top: 1px solid var(--mist);
  }

  .faq-list summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 60px;
    padding: 0.6rem 0;
    cursor: pointer;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary .i {
    margin-left: auto;
    transition: transform 0.25s var(--ease);
  }

  .faq-list details[open] summary .i {
    transform: rotate(180deg);
  }

  .faq-list p {
    padding: 0 2.5rem 1.3rem 0;
    color: var(--slate);
    max-width: 68ch;
  }
</style>
