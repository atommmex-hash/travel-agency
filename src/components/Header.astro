---
interface Props {
  brand: string;
}

const { brand } = Astro.props;
---
<header class="hdr" id="hdr">
  <div class="wrap hdr-in">
    <a class="logo" href="#top" aria-label={`${brand}, home`}>
      <div class="logo-icon">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="#EAF5FF" />
          <path d="M7 23L16 9L25 23H7Z" fill="#008CFF" />
          <path d="M12 23L16 16L20 23H12Z" fill="#FFB400" />
          <circle cx="16" cy="8" r="2.5" fill="#FF3D00" />
        </svg>
      </div>
      <div class="logo-text">
        <span class="brand-name">{brand}</span>
        <span class="brand-tag">Holidays & Treks</span>
      </div>
    </a>

    <nav class="nav" id="nav" aria-label="Main navigation">
      <a href="#trips" class="nav-item">
        <span class="nav-icon">🏔️</span>
        <span>Packages</span>
      </a>
      <a href="#booking" class="nav-item">
        <span class="nav-icon">✨</span>
        <span>Why Us</span>
      </a>
      <a href="#stories" class="nav-item">
        <span class="nav-icon">⭐</span>
        <span>Reviews</span>
      </a>
      <a href="#faq" class="nav-item">
        <span class="nav-icon">💬</span>
        <span>FAQ</span>
      </a>
      <a class="btn btn-whatsapp" href="#enquire">
        <svg class="i" aria-hidden="true"><use href="#i-chat"></use></svg>
        <span>Get Quote</span>
      </a>
    </nav>

    <div class="hdr-actions">
      <button class="saved-pill-btn hdr-saved" id="hdrSaved" aria-label="Saved trips">
        <svg class="i"><use href="#i-heart"></use></svg>
        <span class="saved-label">Shortlist</span>
        <span class="cnt-badge" id="hdrCount" hidden>0</span>
      </button>

      <button class="icon-btn menu-btn" id="menuBtn" aria-expanded="false" aria-controls="nav" aria-label="Open menu">
        <svg class="i" id="menuIcon"><use href="#i-menu"></use></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 4px 16px rgba(0, 50, 120, 0.05);
    transition: box-shadow 0.25s ease;
  }

  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
  }

  .logo-icon svg {
    width: 100%;
    height: 100%;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-weight: 900;
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .brand-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-left: auto;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-muted);
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-s);
    transition: color 0.15s, background 0.15s;
  }

  .nav-item:hover {
    color: var(--primary);
    background: var(--primary-light);
  }

  .nav-icon {
    font-size: 1.05rem;
  }

  .saved-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    background: #FFF5F5;
    border: 1px solid #FED7D7;
    border-radius: var(--r-pill);
    color: var(--accent-red);
    font-weight: 700;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .saved-pill-btn:hover {
    background: #FED7D7;
    transform: translateY(-1px);
  }

  .saved-pill-btn .i {
    width: 18px;
    height: 18px;
    fill: var(--accent-red);
    stroke: var(--accent-red);
  }

  .hdr-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-page);
    color: var(--text-main);
  }

  @media (max-width: 899px) {
    .hdr-saved {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .nav {
      position: fixed;
      inset: 72px 0 0 0;
      z-index: 45;
      margin: 0;
      background: #ffffff;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 1.2rem;
      padding: 2rem var(--pad);
      visibility: hidden;
      opacity: 0;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      transition: opacity 0.2s, visibility 0.2s;
    }
    .nav.open {
      visibility: visible;
      opacity: 1;
    }
    .nav-item {
      font-size: 1.35rem;
      padding: 0.6rem 0;
      width: 100%;
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav .btn {
      margin-top: 1.5rem;
      width: 100%;
      min-height: 52px;
      font-size: 1.1rem;
    }
  }
</style>
