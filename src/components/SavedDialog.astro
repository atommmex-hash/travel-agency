---
// Native HTML dialog for viewing and sharing saved trips shortlist
---
<dialog id="savedDlg" aria-label="Saved trips">
  <button class="x" data-close aria-label="Close">
    <svg class="i" aria-hidden="true"><use href="#i-x"></use></svg>
  </button>
  <div id="savedBody"></div>
</dialog>

<style>
  dialog {
    border: 0;
    padding: 0;
    width: min(640px, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--snow);
    color: var(--ink);
    border-radius: var(--r-l);
    box-shadow: 0 30px 80px rgba(5, 12, 22, 0.5);
  }

  dialog::backdrop {
    background: rgba(9, 19, 33, 0.66);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  dialog[open] {
    animation: pop 0.35s var(--ease);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 720px) {
    dialog {
      width: 100%;
      margin: auto 0 0;
      max-height: 92vh;
      max-height: 92dvh;
      border-radius: var(--r-l) var(--r-l) 0 0;
    }
    dialog[open] {
      animation: sheet 0.4s var(--ease);
    }
  }

  :global(.sv) {
    padding: 1.6rem;
  }

  :global(.sv h2) {
    font-size: 2.4rem;
    margin: 1.2rem 0 1.2rem;
  }

  :global(.sv-list) {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  :global(.sv-list li) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-top: 1px solid var(--mist);
  }

  :global(.sv-list li div:first-child) {
    display: grid;
  }

  :global(.sv-list span) {
    color: var(--slate);
    font-size: 0.875rem;
  }

  :global(.sv-act) {
    display: flex;
  }

  :global(.sv .btn) {
    width: 100%;
  }
</style>
