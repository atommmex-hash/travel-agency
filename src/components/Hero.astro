---
import PromoCarousel from './PromoCarousel.astro';

interface Props {
  headline?: string;
  lead?: string;
  peakName?: string;
  peakMetres?: number;
  finePrint?: string;
  whatsappUrl?: string;
}

const { headline = 'Explore Mountain Holidays' } = Astro.props;
---
<section class="hero" aria-labelledby="hero-h">
  <div class="hero-bg">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
  </div>

  <div class="wrap hero-content">
    <h1 class="sr-only" id="hero-h">{headline}</h1>

    <!-- Commercial Ad Banner Carousel (Trending & Newly Launched) -->
    <PromoCarousel />

    <!-- MMT-Style Floating Search & Filter Box -->
    <div class="search-card" role="search" aria-label="Find packages">
      <div class="search-tabs" role="tablist">
        <button type="button" class="search-tab active" data-dest-pick="All" role="tab" aria-selected="true">
          <svg class="i tab-svg" aria-hidden="true"><use href="#i-sparkle"></use></svg>
          <span>All Packages</span>
        </button>
        <button type="button" class="search-tab" data-dest-pick="Darjeeling" role="tab" aria-selected="false">
          <svg class="i tab-svg" aria-hidden="true"><use href="#i-compass"></use></svg>
          <span>Darjeeling</span>
        </button>
        <button type="button" class="search-tab" data-dest-pick="Sikkim" role="tab" aria-selected="false">
          <svg class="i tab-svg" aria-hidden="true"><use href="#i-mountain"></use></svg>
          <span>Sikkim</span>
        </button>
        <button type="button" class="search-tab" data-dest-pick="North Sikkim" role="tab" aria-selected="false">
          <svg class="i tab-svg" aria-hidden="true"><use href="#i-pin"></use></svg>
          <span>North Sikkim</span>
        </button>
        <button type="button" class="search-tab" data-dest-pick="Kalimpong" role="tab" aria-selected="false">
          <svg class="i tab-svg" aria-hidden="true"><use href="#i-home"></use></svg>
          <span>Homestays</span>
        </button>
      </div>

      <div class="search-fields">
        <!-- DESTINATION FIELD -->
        <div class="field-box" id="fieldBoxDest" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Destination">
          <div class="field-content">
            <span class="field-label">DESTINATION</span>
            <div class="field-value-row">
              <span class="field-value" id="heroDestVal">All Destinations</span>
              <svg class="i chev-svg" aria-hidden="true"><use href="#i-chev"></use></svg>
            </div>
            <span class="field-sub" id="heroDestSub">Darjeeling, Gangtok, Pelling & more</span>
          </div>

          <div class="field-dropdown" id="dropdownDest" role="listbox" hidden>
            <button type="button" class="dropdown-item active" data-dest="All" role="option">
              <b>All Destinations</b>
              <span>Darjeeling, Gangtok, Pelling, Kalimpong</span>
            </button>
            <button type="button" class="dropdown-item" data-dest="Gangtok" role="option">
              <b>Gangtok & East Sikkim</b>
              <span>Tsomgo Lake, Nathula Pass, MG Marg</span>
            </button>
            <button type="button" class="dropdown-item" data-dest="North Sikkim" role="option">
              <b>North Sikkim</b>
              <span>Gurudongmar Lake, Lachen, Yumthang</span>
            </button>
            <button type="button" class="dropdown-item" data-dest="Darjeeling" role="option">
              <b>Darjeeling</b>
              <span>Tiger Hill Sunrise, Toy Train, Chowrasta</span>
            </button>
            <button type="button" class="dropdown-item" data-dest="Pelling" role="option">
              <b>West Sikkim & Pelling</b>
              <span>Glass Skywalk, Rabdentse, Buddha Park</span>
            </button>
            <button type="button" class="dropdown-item" data-dest="Kalimpong" role="option">
              <b>Kalimpong & Mirik</b>
              <span>Pine trails, Lamahatta, quiet homestays</span>
            </button>
          </div>
        </div>

        <div class="field-divider"></div>

        <!-- TRIP DURATION FIELD -->
        <div class="field-box" id="fieldBoxDur" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Trip Duration">
          <div class="field-content">
            <span class="field-label">TRIP DURATION</span>
            <div class="field-value-row">
              <span class="field-value" id="heroDurVal">Any Length</span>
              <svg class="i chev-svg" aria-hidden="true"><use href="#i-chev"></use></svg>
            </div>
            <span class="field-sub" id="heroDurSub">Weekend 2N to Grand 6N+</span>
          </div>

          <div class="field-dropdown" id="dropdownDur" role="listbox" hidden>
            <button type="button" class="dropdown-item active" data-dur="any" role="option">
              <b>Any Length</b>
              <span>All package durations</span>
            </button>
            <button type="button" class="dropdown-item" data-dur="short" role="option">
              <b>Weekend (2–3 Nights)</b>
              <span>Quick getaways & short escapes</span>
            </button>
            <button type="button" class="dropdown-item" data-dur="mid" role="option">
              <b>Popular (4–5 Nights)</b>
              <span>Standard family & couple trips</span>
            </button>
            <button type="button" class="dropdown-item" data-dur="long" role="option">
              <b>Expedition (6+ Nights)</b>
              <span>In-depth mountain explorations</span>
            </button>
          </div>
        </div>

        <div class="field-divider"></div>

        <!-- BUDGET PER PERSON FIELD -->
        <div class="field-box" id="fieldBoxBudget" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-label="Select Budget">
          <div class="field-content">
            <span class="field-label">BUDGET PER PERSON</span>
            <div class="field-value-row">
              <span class="field-value" id="heroBudgetVal">Flexible</span>
              <svg class="i chev-svg" aria-hidden="true"><use href="#i-chev"></use></svg>
            </div>
            <span class="field-sub" id="heroBudgetSub">From ₹7,500 to ₹35,000+</span>
          </div>

          <div class="field-dropdown" id="dropdownBudget" role="listbox" hidden>
            <button type="button" class="dropdown-item active" data-budget="35000" role="option">
              <b>Flexible (All Budgets)</b>
              <span>Show all packages</span>
            </button>
            <button type="button" class="dropdown-item" data-budget="10000" role="option">
              <b>Under ₹10,000</b>
              <span>Budget friendly mountain escapes</span>
            </button>
            <button type="button" class="dropdown-item" data-budget="15000" role="option">
              <b>Under ₹15,000</b>
              <span>Popular mid-range tours</span>
            </button>
            <button type="button" class="dropdown-item" data-budget="20000" role="option">
              <b>Under ₹20,000</b>
              <span>Comprehensive multi-day tours</span>
            </button>
            <button type="button" class="dropdown-item" data-budget="35000" role="option">
              <b>Above ₹20,000</b>
              <span>Grand expeditions & signature stays</span>
            </button>
          </div>
        </div>

        <!-- SEARCH BUTTON -->
        <button type="button" class="btn btn-gold search-btn" id="heroSearchTrigger" aria-label="Search Holidays">
          <svg class="i search-btn-svg" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21L16.65 16.65" />
          </svg>
          <span>SEARCH HOLIDAYS</span>
        </button>
      </div>

      <div class="search-pills-row">
        <span class="pills-label">Popular Searches:</span>
        <div class="pills-list">
          <button type="button" class="mini-pill" data-quick-dest="Darjeeling">Tiger Hill Sunrise</button>
          <button type="button" class="mini-pill" data-quick-dest="Gangtok">Tsomgo Lake</button>
          <button type="button" class="mini-pill" data-quick-dest="North Sikkim">Gurudongmar Lake</button>
          <button type="button" class="mini-pill" data-quick-dest="Kalimpong">Kalimpong Homestay</button>
        </div>
      </div>
    </div>

    <!-- Trust Badges -->
    <div class="hero-trust">
      <div class="trust-item">
        <svg class="i trust-svg" aria-hidden="true"><use href="#i-chat"></use></svg>
        <span>Instant WhatsApp Planning</span>
      </div>
      <div class="trust-item">
        <svg class="i trust-svg star-icon" aria-hidden="true"><use href="#i-star"></use></svg>
        <span>4.9/5 Rated on Google</span>
      </div>
      <div class="trust-item">
        <svg class="i trust-svg" aria-hidden="true"><use href="#i-refresh"></use></svg>
        <span>Free Date Changes</span>
      </div>
      <div class="trust-item">
        <svg class="i trust-svg" aria-hidden="true"><use href="#i-shield"></use></svg>
        <span>Local Himalayan Guides</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(145deg, #0056C6 0%, #008CFF 60%, #38B6FF 100%);
    color: #ffffff;
    padding: clamp(1.25rem, 3vw, 2rem) 0 clamp(3.5rem, 6vw, 5rem);
    overflow: visible;
    z-index: 10;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.25;
  }

  .hero-shape-1 {
    width: 500px;
    height: 500px;
    background: #FFD166;
    top: -150px;
    right: -100px;
  }

  .hero-shape-2 {
    width: 600px;
    height: 600px;
    background: #06D6A0;
    bottom: -200px;
    left: -150px;
    opacity: 0.2;
  }

  .hero-shape-3 {
    width: 350px;
    height: 350px;
    background: #FF3D00;
    top: 40%;
    left: 45%;
    opacity: 0.12;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Search Card */
  .search-card {
    width: 100%;
    max-width: 1040px;
    background: #ffffff;
    border-radius: var(--r-l);
    color: var(--text-main);
    box-shadow: 0 20px 50px rgba(0, 45, 110, 0.22);
    padding: 0.75rem 1.5rem 1.5rem;
    text-align: left;
    position: relative;
    z-index: 30;
  }

  .search-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
    margin-bottom: 1.2rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .search-tabs::-webkit-scrollbar {
    display: none;
  }

  .search-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--r-pill);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-muted);
    background: transparent;
    white-space: nowrap;
    transition: all 0.2s;
  }

  .search-tab:hover {
    color: var(--primary);
    background: var(--primary-light);
  }

  .search-tab.active {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(0, 140, 255, 0.3);
  }

  .tab-svg {
    width: 16px;
    height: 16px;
  }

  .search-fields {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto;
    align-items: center;
    background: var(--bg-card-alt);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--r-m);
    padding: 0.75rem 1.2rem;
    gap: 1rem;
  }

  .field-box {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.65rem;
    border-radius: var(--r-s);
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s;
    user-select: none;
    outline: none;
  }

  .field-box:hover,
  .field-box:focus-visible {
    background: #EBF8FF;
  }

  .field-box.open {
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 140, 255, 0.18);
    border-radius: var(--r-s) var(--r-s) 0 0;
    z-index: 60;
  }

  .field-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .field-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--primary);
    letter-spacing: 0.05em;
  }

  .field-value-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .field-value {
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
  }

  .chev-svg {
    width: 14px;
    height: 14px;
    color: var(--primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .field-box.open .chev-svg {
    transform: rotate(180deg);
  }

  .field-sub {
    font-size: 0.78rem;
    color: var(--text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .field-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 270px;
    max-width: 320px;
    max-height: min(380px, 70vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #ffffff;
    border-radius: var(--r-m);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 18px 42px rgba(0, 35, 90, 0.22);
    padding: 0.4rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    animation: dropFade 0.15s ease-out;
    scrollbar-width: thin;
  }

  #dropdownBudget {
    right: 0;
    left: auto;
  }

  @keyframes dropFade {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-s);
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    transition: all 0.12s;
    width: 100%;
  }

  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background: var(--primary-light);
    outline: none;
  }

  .dropdown-item.active {
    background: #EBF8FF;
    border-left: 3px solid var(--primary);
  }

  .dropdown-item b {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .dropdown-item span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .field-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }

  .search-btn {
    min-height: 52px;
    padding: 0 1.8rem;
    font-size: 1rem;
    letter-spacing: 0.02em;
    box-shadow: 0 6px 18px rgba(255, 109, 0, 0.4);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .search-btn-svg {
    width: 18px;
    height: 18px;
    stroke-width: 2.5;
  }

  .search-pills-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .pills-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-light);
  }

  .pills-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mini-pill {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-card-alt);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-pill);
    transition: all 0.15s;
  }

  .mini-pill:hover {
    background: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
  }

  /* Trust Bar */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    background: rgba(255, 255, 255, 0.14);
    padding: 0.45rem 1rem;
    border-radius: var(--r-pill);
    backdrop-filter: blur(8px);
  }

  .trust-svg {
    width: 17px;
    height: 17px;
  }

  .star-icon {
    fill: #FFD166;
    stroke: #FFD166;
  }

  @media (max-width: 991px) {
    .search-fields {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .field-divider {
      display: none;
    }
    .field-dropdown, #dropdownBudget {
      left: 0;
      right: 0;
      min-width: 100%;
      max-width: 100%;
    }
    .search-btn {
      width: 100%;
    }
  }
</style>
