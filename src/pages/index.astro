---
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import '../styles/base.css';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TripFilters from '../components/TripFilters.astro';
import TripCard from '../components/TripCard.astro';
import BookingAndWhy from '../components/BookingAndWhy.astro';
import Stories from '../components/Stories.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import Toast from '../components/Toast.astro';
import TripDialog from '../components/TripDialog.astro';
import SavedDialog from '../components/SavedDialog.astro';
import { siteData, storiesData, faqData } from '../lib/content';
import { buildGeneralEnquiryUrl } from '../lib/whatsapp';

const tripsCollection = await getCollection('trips');
const trips = tripsCollection.map((t) => t.data);

// Sort so featured trip is first
trips.sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

// Extract unique destination names
const destinations = Array.from(new Set(trips.map((t) => t.destination)));

const generalWaUrl = buildGeneralEnquiryUrl(siteData.brand, siteData.whatsapp);

// JSON-LD structured data for TravelAgency
const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": siteData.brand,
  "telephone": siteData.phone,
  "email": siteData.email,
  "areaServed": destinations,
  "url": "https://himaltrails.example"
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{siteData.brand} | Darjeeling & Sikkim Holiday Packages</title>
  <meta name="description" content={`Book handcrafted Darjeeling, Sikkim, and Dooars holiday packages with ${siteData.brand}. Verified stays, private cabs, and transparent pricing.`} />
  <meta name="theme-color" content="#008CFF" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${siteData.brand} | Himalayan Holiday Packages`} />
  <meta property="og:description" content={siteData.hero.lead} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://himaltrails.example" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={schemaJson} />
</head>
<body id="top">
  <a class="skip-link" href="#trips">Skip to packages</a>
  <Icons />

  <Header brand={siteData.brand} />

  <main>
    <Hero
      headline={siteData.hero.headline}
      lead={siteData.hero.lead}
      peakName={siteData.hero.peak.name}
      peakMetres={siteData.hero.peak.metres}
      finePrint={siteData.finePrint}
      whatsappUrl={generalWaUrl}
    />

    <section class="sec wrap" id="trips" aria-labelledby="trips-h">
      <div class="packages-header">
        <span class="sec-badge">TOP RATED PACKAGES</span>
        <h2 id="trips-h">Explore Mountain Itineraries</h2>
        <p class="lead">Every package includes private mountain transfers, verified hotel stays, and entry permits.</p>
      </div>

      <TripFilters destinations={destinations} />

      <div class="grid" id="grid">
        {trips.map((trip, idx) => (
          <TripCard trip={trip} index={idx} />
        ))}
      </div>

      <noscript>
        <p class="fine" style="margin-top:1rem;color:var(--text-muted)">
          Showing all pre-rendered packages. Enable JavaScript for interactive budget filtering and cost estimates.
        </p>
      </noscript>
    </section>

    <BookingAndWhy />

    <Stories stories={storiesData} />

    <Faq faq={faqData} />

    <EnquiryForm phone={siteData.phone} email={siteData.email} />
  </main>

  <Footer brand={siteData.brand} />

  <MobileDock phone={siteData.phone} whatsappUrl={generalWaUrl} />

  <Toast />

  <TripDialog />

  <SavedDialog />

  <!-- Client-side Interactive Logic (No Emojis, Pure SVG Icons) -->
  <script is:inline define:vars={{ trips, siteData }}>
    (() => {
      'use strict';

      const CONFIG = {
        brand: siteData.brand,
        whatsapp: siteData.whatsapp
      };

      const TIERS = [
        { n: 'Comfort', m: 1 },
        { n: 'Premium', m: 1.35 },
        { n: 'Luxury', m: 1.8 }
      ];

      const TRIPS = trips;

      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const fmt = (n) => '\u20B9' + n.toLocaleString('en-IN');
      const metres = (n) => n.toLocaleString('en-IN') + ' m';
      const wa = (msg) => `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(msg)}`;
      const ico = (n) => `<svg class="i" aria-hidden="true"><use href="#i-${n}"/></svg>`;

      const store = {
        get(k, d) {
          try {
            const v = localStorage.getItem(k);
            return v ? JSON.parse(v) : d;
          } catch (e) {
            return d;
          }
        },
        set(k, v) {
          try {
            localStorage.setItem(k, JSON.stringify(v));
          } catch (e) {}
        }
      };

      let toastT;
      function toast(msg) {
        const t = $('#toast');
        if (!t) return;
        t.textContent = msg;
        t.classList.add('show');
        clearTimeout(toastT);
        toastT = setTimeout(() => t.classList.remove('show'), 2200);
      }

      function rng(seed) {
        let s = seed % 2147483647;
        if (s <= 0) s += 2147483646;
        return () => (s = (s * 16807) % 2147483647) / 2147483647;
      }

      function rings({ seed, cx, cy, n, rMax, sx = 1.25, sy = 1, pts = 64, pow = 1.15 }) {
        const r = rng(seed);
        const p = [r() * 6.28, r() * 6.28, r() * 6.28];
        const a = [0.06 + r() * 0.03, 0.04 + r() * 0.02, 0.02 + r() * 0.01];
        const out = [];
        for (let i = 0; i < n; i++) {
          const base = rMax * Math.pow(1 - i / n, pow);
          const line = [];
          for (let k = 0; k <= pts; k++) {
            const th = (k / pts) * Math.PI * 2;
            const w =
              1 +
              a[0] * Math.sin(2 * th + p[0] + i * 0.06) +
              a[1] * Math.sin(3 * th + p[1] - i * 0.05) +
              a[2] * Math.sin(5 * th + p[2] + i * 0.07);
            line.push([cx + Math.cos(th) * base * w * sx, cy + Math.sin(th) * base * w * sy]);
          }
          out.push(line);
        }
        return out;
      }

      const pathOf = (pts) => 'M' + pts.map((p) => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join('L') + 'Z';

      function plate(t, ctx) {
        if (t.photo) {
          return `<img src="${t.photo}" alt="${t.title}" loading="lazy" width="400" height="260" style="width:100%;height:100%;object-fit:cover"/>`;
        }
        const W = 400;
        const H = 260;
        const cx = W * (t.plate.px || 0.5);
        const cy = H * (t.plate.py || 0.5);
        const id = `pg-${ctx}-${t.id}`;
        const R = rings({ seed: t.plate.seed, cx, cy, n: 14, rMax: 230, pts: 64 });
        let s = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${t.plate.bg[0]}"/><stop offset="1" stop-color="${t.plate.bg[1]}"/></linearGradient></defs><rect width="${W}" height="${H}" fill="url(#${id})"/>`;
        R.forEach((line, i) => {
          const hi = i >= R.length - 3;
          const idx = i % 4 === 0;
          s += `<path d="${pathOf(line)}" fill="none" stroke="${hi ? '#FFB400' : '#90CDF4'}" stroke-opacity="${hi ? (0.65 + (i - (R.length - 3)) * 0.15).toFixed(2) : idx ? 0.5 : 0.25}" stroke-width="${hi ? 1.5 : idx ? 1.3 : 1}" stroke-linejoin="round"/>`;
        });
        s += `<path d="M${cx},${cy - 7}l6,11h-12z" fill="#FFB400"/><text x="${cx + 12}" y="${cy + 4}" fill="#fff" font-size="13" font-weight="700" paint-order="stroke" stroke="#0E1A2B" stroke-width="5" stroke-linejoin="round">${metres(t.highestPointMetres)}</text></svg>`;
        return s;
      }

      /* ==========================================================
         FILTERS & PACKAGES
         ========================================================= */
      const state = { dest: 'All', dur: 'any', max: 35000 };
      const durOk = (n) =>
        state.dur === 'any' ||
        (state.dur === 'short' && n <= 3) ||
        (state.dur === 'mid' && n >= 4 && n <= 5) ||
        (state.dur === 'long' && n >= 6);

      let saved = new Set(store.get('ht_saved', []));

      function cardHTML(t, i) {
        const altPercent = Math.min(100, (t.highestPointMetres / 5000) * 100);
        const daysCount = t.nights + 1;
        const originalPrice = Math.round((t.pricePerPerson * 1.2) / 500) * 500;
        const savings = originalPrice - t.pricePerPerson;

        return `<article class="package-card${t.featured ? ' featured-deal' : ''}" style="--i:${i}; --p:${altPercent}%" data-id="${t.id}">
          <div class="card-media">
            ${plate(t, 'c')}
            <div class="media-overlay-top">
              ${
                t.tag
                  ? `<span class="badge-tag deal-flame"><svg class="i badge-svg" aria-hidden="true"><use href="#i-sparkle"/></svg><span>${t.tag.toUpperCase()}</span></span>`
                  : `<span class="badge-tag rating-star"><svg class="i badge-svg star-icon" aria-hidden="true"><use href="#i-star"/></svg><span>4.9 (120+)</span></span>`
              }
              <button class="heart-circle" data-save="${t.id}" aria-pressed="${saved.has(t.id)}" aria-label="Save ${t.title}">${ico('heart')}</button>
            </div>
            <div class="media-overlay-bottom">
              <span class="alt-chip"><svg class="i chip-svg" aria-hidden="true"><use href="#i-mountain"/></svg><span>${formatMetres(t.highestPointMetres)}</span></span>
              <span class="duration-chip">${t.nights}N / ${daysCount}D</span>
            </div>
          </div>
          <div class="card-content">
            <div class="dest-row">
              <span class="dest-badge"><svg class="i pin-svg" aria-hidden="true"><use href="#i-pin"/></svg><span>${t.destination}</span></span>
              <span class="cancellation-badge">Free Date Change</span>
            </div>
            <h3 class="package-title">${t.title}</h3>
            <div class="amenities-row">
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-home"/></svg><span>Stay</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-car"/></svg><span>Private Cab</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-utensils"/></svg><span>Meals</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-ticket"/></svg><span>Permits</span></span>
            </div>
            <ul class="highlights-list">
              ${t.highlights.slice(0, 3).map((h) => `<li>${h}</li>`).join('')}
            </ul>
            <div class="card-footer">
              <div class="price-block">
                <div class="mrp-row">
                  <span class="mrp">${fmt(originalPrice)}</span>
                  <span class="save-tag">SAVE ${fmt(savings)}</span>
                </div>
                <div class="deal-price-row">
                  <strong class="deal-price">${fmt(t.pricePerPerson)}</strong>
                  <span class="per-person">/ person</span>
                </div>
              </div>
              <div class="action-buttons">
                <button class="btn btn-primary view-btn" data-open="${t.id}">View Deal</button>
              </div>
            </div>
          </div>
        </article>`;
      }

      function renderTrips() {
        const list = TRIPS.filter(
          (t) =>
            (state.dest === 'All' || t.destination === state.dest) &&
            durOk(t.nights) &&
            t.pricePerPerson <= state.max
        );
        $('#grid').innerHTML = list.map(cardHTML).join('');
        $('#count').textContent = list.length
          ? `${list.length} package${list.length > 1 ? 's' : ''} available`
          : '0 packages match';
        $('#empty').hidden = list.length > 0;

        // Sync hero display labels
        if ($('#heroDestVal')) {
          $('#heroDestVal').textContent = state.dest === 'All' ? 'All Destinations' : state.dest;
        }
        if ($('#heroDurVal')) {
          const durMap = { any: 'Any Length', short: 'Weekend (2–3N)', mid: 'Popular (4–5N)', long: 'Expedition (6N+)' };
          $('#heroDurVal').textContent = durMap[state.dur] || 'Any Length';
        }
      }

      function setDestination(dest) {
        state.dest = dest;
        $$('#destChips .chip').forEach((c) => c.setAttribute('aria-pressed', c.dataset.v === dest));
        $$('.search-tab').forEach((t) => {
          const match = t.dataset.destPick === dest;
          t.classList.toggle('active', match);
          t.setAttribute('aria-selected', String(match));
        });
        renderTrips();
      }

      function budgetLabel() {
        $('#budgetOut').textContent = state.max >= 35000 ? 'Any' : 'Up to ' + fmt(state.max);
        if ($('#heroBudgetVal')) {
          $('#heroBudgetVal').textContent = state.max >= 35000 ? 'Flexible' : 'Up to ' + fmt(state.max);
        }
      }

      function resetFilters() {
        state.dest = 'All';
        state.dur = 'any';
        state.max = 35000;
        $('#budget').value = 35000;
        budgetLabel();
        $$('#destChips .chip').forEach((c) => c.setAttribute('aria-pressed', c.dataset.v === 'All'));
        $$('#durChips .chip').forEach((c) => c.setAttribute('aria-pressed', c.dataset.v === 'any'));
        $$('.search-tab').forEach((t) => {
          const match = t.dataset.destPick === 'All';
          t.classList.toggle('active', match);
          t.setAttribute('aria-selected', String(match));
        });
        renderTrips();
      }

      /* ==========================================================
         SAVED TRIPS SHORTLIST
         ========================================================== */
      function syncSaved() {
        $$('[data-save]').forEach((b) => b.setAttribute('aria-pressed', saved.has(b.dataset.save)));
        ['#dockCount', '#hdrCount'].forEach((sel) => {
          const el = $(sel);
          if (el) {
            el.textContent = saved.size;
            el.hidden = saved.size === 0;
          }
        });
        if ($('#savedDlg') && $('#savedDlg').open) renderSaved();
      }

      function toggleSave(id) {
        const t = TRIPS.find((x) => x.id === id);
        if (!t) return;
        if (saved.has(id)) {
          saved.delete(id);
          toast('Removed from saved shortlist');
        } else {
          saved.add(id);
          toast(`Saved ${t.title} to shortlist`);
        }
        store.set('ht_saved', [...saved]);
        syncSaved();
      }

      function renderSaved() {
        const list = [...saved].map((id) => TRIPS.find((t) => t.id === id)).filter(Boolean);
        const msg = `Hi ${CONFIG.brand}! I'm shortlisting these packages: ${list.map((t) => t.title).join(', ')}. Can you help me plan?`;
        $('#savedBody').innerHTML =
          `<div class="sv"><h2>My Shortlist</h2>` +
          (list.length
            ? `<ul class="sv-list">${list
                .map(
                  (t) =>
                    `<li><div><strong>${t.title}</strong><span>${t.nights} nights, from ${fmt(t.pricePerPerson)}</span></div><div class="sv-act"><button class="link" data-open="${t.id}">View</button><button class="link" data-save="${t.id}">Remove</button></div></li>`
                )
                .join('')}</ul><a class="btn btn-whatsapp" target="_blank" rel="noopener" href="${wa(msg)}">${ico('chat')}Send Shortlist on WhatsApp</a>`
            : `<p class="muted" style="margin-bottom:1.5rem">No packages saved yet. Tap the heart on any card to save it here, then send your shortlist in one WhatsApp message.</p><a class="btn btn-primary" href="#trips" data-close>Browse Packages</a>`) +
          `</div>`;
      }

      /* ==========================================================
         TRIP DIALOG & ESTIMATOR
         ========================================================== */
      const tripDlg = $('#tripDlg');
      const savedDlg = $('#savedDlg');
      let current = null;
      let est = { n: 2, tier: 0 };

      function tripHTML(t) {
        return `<button class="x" data-close aria-label="Close">${ico('x')}</button>
        <div class="sheet-plate">${plate(t, 'd')}
          <button class="heart-circle" data-save="${t.id}" aria-pressed="${saved.has(t.id)}" aria-label="Save ${t.title}">${ico('heart')}</button>
          <div class="sheet-title">
            <p>${t.destination} • ${t.nights} Nights / ${t.nights + 1} Days</p>
            <h2 id="tripTitle">${t.title}</h2>
          </div>
        </div>
        <div class="sheet-grid">
          <div class="sheet-main">
            <h3>Day-by-Day Itinerary</h3>
            <div class="acc">${t.days
              .map(
                (d, i) =>
                  `<details${i === 0 ? ' open' : ''}><summary><span class="dn">${d.label}</span><span class="dt">${d.title}</span>${ico('chev')}</summary><p>${d.text}</p></details>`
              )
              .join('')}</div>
            <h3>What's Included</h3>
            <ul class="inc">${t.included.map((x) => `<li>${ico('check')}<span>${x}</span></li>`).join('')}</ul>
          </div>
          <aside class="est" aria-label="Trip estimate">
            <h3>Estimate Package Cost</h3>
            <div class="est-row">
              <span id="lblTrav" style="font-weight:700">Number of Travellers</span>
              <div class="stepper" role="group" aria-labelledby="lblTrav">
                <button data-step="-1" aria-label="Fewer travellers">${ico('minus')}</button>
                <output id="estN" aria-live="polite">2</output>
                <button data-step="1" aria-label="More travellers">${ico('plus')}</button>
              </div>
            </div>
            <fieldset class="tiers">
              <legend>Hotel Stay Category</legend>
              ${TIERS.map(
                (x, i) =>
                  `<label class="tier"><input type="radio" name="tier" value="${i}"${i === 0 ? ' checked': ''}><span>${x.n}</span></label>`
              ).join('')}
            </fieldset>
            <div class="est-total">
              <span>Estimated Total (Twin Sharing)</span>
              <strong id="estTotal"></strong>
              <small id="estPer"></small>
            </div>
            <a class="btn btn-whatsapp" id="estWa" target="_blank" rel="noopener">${ico('chat')}Get Exact Quote on WhatsApp</a>
            <p class="fine">Indicative quote. Final rate depends on travel dates and room availability.</p>
          </aside>
        </div>`;
      }

      function updateEst() {
        const t = current;
        if (!t) return;
        const tier = TIERS[est.tier];
        const per = Math.round((t.pricePerPerson * tier.m) / 100) * 100;
        const total = per * est.n;
        $('#estN').textContent = est.n;
        $('#estTotal').textContent = fmt(total);
        $('#estPer').textContent = `${fmt(per)} per person (${tier.n} accommodation)`;
        $('#estWa').href = wa(
          `Hi ${CONFIG.brand}! I'm interested in the "${t.title}" package for ${est.n} traveller${est.n > 1 ? 's' : ''} (${tier.n} stay). Could you share availability and the final quote?`
        );
        $$('[data-step]', tripDlg).forEach(
          (b) =>
            (b.disabled =
              (b.dataset.step === '-1' && est.n <= 1) || (b.dataset.step === '1' && est.n >= 12))
        );
      }

      function openTrip(id) {
        current = TRIPS.find((t) => t.id === id);
        if (!current) return;
        est = { n: 2, tier: 0 };
        $('#tripBody').innerHTML = tripHTML(current);
        updateEst();
        document.body.classList.add('lock');
        if (!tripDlg.open) tripDlg.showModal();
        tripDlg.scrollTop = 0;
      }

      function openSaved() {
        renderSaved();
        document.body.classList.add('lock');
        savedDlg.showModal();
      }

      /* ==========================================================
         EVENT LISTENERS & DELEGATION
         ========================================================== */
      document.addEventListener('click', (e) => {
        const o = e.target.closest('[data-open]');
        if (o) {
          if (savedDlg.open) savedDlg.close();
          openTrip(o.dataset.open);
          return;
        }
        const sv = e.target.closest('[data-save]');
        if (sv) {
          toggleSave(sv.dataset.save);
          return;
        }
        const st = e.target.closest('[data-step]');
        if (st) {
          est.n = Math.min(12, Math.max(1, est.n + Number(st.dataset.step)));
          updateEst();
          return;
        }
        const c = e.target.closest('[data-close]');
        if (c) {
          const d = c.closest('dialog');
          if (d) d.close();
        }

        // Hero Search Tabs click
        const tab = e.target.closest('[data-dest-pick]');
        if (tab) {
          setDestination(tab.dataset.destPick);
          return;
        }

        // Hero quick pills
        const qPill = e.target.closest('[data-quick-dest]');
        if (qPill) {
          setDestination(qPill.dataset.quickDest);
          document.getElementById('trips')?.scrollIntoView({ behavior: 'smooth' });
          return;
        }
      });

      // Destination chips click
      $('#destChips')?.addEventListener('click', (e) => {
        const b = e.target.closest('.chip');
        if (!b) return;
        setDestination(b.dataset.v);
      });

      // Duration chips click
      $('#durChips')?.addEventListener('click', (e) => {
        const b = e.target.closest('.chip');
        if (!b) return;
        state.dur = b.dataset.v;
        $$('.chip', '#durChips').forEach((c) => c.setAttribute('aria-pressed', c === b));
        renderTrips();
      });

      tripDlg.addEventListener('change', (e) => {
        if (e.target.name === 'tier') {
          est.tier = Number(e.target.value);
          updateEst();
        }
      });

      [tripDlg, savedDlg].forEach((d) => {
        d.addEventListener('click', (e) => {
          if (e.target === d) d.close();
        });
        d.addEventListener('close', () => {
          if (!tripDlg.open && !savedDlg.open) document.body.classList.remove('lock');
        });
      });

      $('#dockSaved')?.addEventListener('click', openSaved);
      $('#hdrSaved')?.addEventListener('click', openSaved);
      $('#budget')?.addEventListener('input', (e) => {
        state.max = Number(e.target.value);
        budgetLabel();
        renderTrips();
      });
      $('#resetF')?.addEventListener('click', resetFilters);
      $('#resetFEmpty')?.addEventListener('click', resetFilters);

      /* Mobile menu toggle */
      const nav = $('#nav');
      const menuBtn = $('#menuBtn');

      function setMenu(open) {
        nav?.classList.toggle('open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        const icon = $('#menuIcon');
        if (icon) {
          icon.innerHTML = `<use href="#i-${open ? 'x' : 'menu'}"/>`;
        }
        document.body.classList.toggle('lock', open);
      }

      menuBtn?.addEventListener('click', () => setMenu(!nav?.classList.contains('open')));
      nav?.addEventListener('click', (e) => {
        if (e.target.closest('a')) setMenu(false);
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('open')) setMenu(false);
      });

      /* Dynamic month generator (next 7 months) */
      const mSel = $('#fMonth');
      if (mSel) {
        const now = new Date();
        for (let i = 0; i < 7; i++) {
          const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
          const opt = document.createElement('option');
          opt.value = d.toLocaleString('en-IN', { month: 'long', year: 'numeric' });
          opt.textContent = opt.value;
          mSel.appendChild(opt);
        }
      }

      /* Enquiry form submit handler */
      $('#form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const f = new FormData(e.target);
        const name = String(f.get('name') || '').trim();
        const n = Math.max(1, Number(f.get('n')) || 1);
        const month = String(f.get('month') || 'Not sure yet');
        const note = String(f.get('note') || '').trim();
        const msgEl = $('#formMsg');

        if (!name) {
          if (msgEl) {
            msgEl.textContent = 'Please enter your name.';
            msgEl.classList.remove('success');
          }
          e.target.elements.name?.focus();
          return;
        }

        const savedList = [...saved]
          .map((id) => TRIPS.find((t) => t.id === id))
          .filter(Boolean)
          .map((t) => t.title);

        let msg = `Hi ${CONFIG.brand}! I'm ${name}. We are planning a mountain trip for ${n} traveller${n > 1 ? 's' : ''}, thinking of ${month}.`;
        if (savedList.length) msg += ` Shortlisted packages: ${savedList.join(', ')}.`;
        if (note) msg += ` Note: ${note}`;

        if (msgEl) {
          msgEl.textContent = 'Opening WhatsApp with your holiday inquiry...';
          msgEl.classList.add('success');
        }
        window.open(wa(msg), '_blank', 'noopener');
      });

      /* Initialize */
      budgetLabel();
      syncSaved();
    })();
  </script>
</body>
</html>

