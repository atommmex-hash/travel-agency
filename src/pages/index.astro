---
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import '../styles/base.css';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TripCard from '../components/TripCard.astro';
import BookingAndWhy from '../components/BookingAndWhy.astro';
import Stories from '../components/Stories.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import Toast from '../components/Toast.astro';
import TripDialog from '../components/TripDialog.astro';
import SavedDialog from '../components/SavedDialog.astro';
import { siteData, storiesData, faqData } from '../lib/content';
import { buildGeneralEnquiryUrl } from '../lib/whatsapp';

const tripsCollection = await getCollection('trips');
const trips = tripsCollection.map((t) => t.data);

// Sort so featured trip is first
trips.sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

// Extract unique destination names
const destinations = Array.from(new Set(trips.map((t) => t.destination)));

const generalWaUrl = buildGeneralEnquiryUrl(siteData.brand, siteData.whatsapp);

// JSON-LD structured data for TravelAgency
const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": siteData.brand,
  "telephone": siteData.phone,
  "email": siteData.email,
  "areaServed": destinations,
  "url": "https://himaltrails.example"
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{siteData.brand} | Book Sikkim & Darjeeling Tour Packages</title>
  <meta name="description" content={`Book budget friendly Sikkim, Gangtok, and Darjeeling holiday packages with ${siteData.brand}. Verified hotel stays, private cabs, and 100% arranged permits.`} />
  <meta name="theme-color" content="#008CFF" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${siteData.brand} | Sikkim & Darjeeling Holiday Tour Packages`} />
  <meta property="og:description" content={siteData.hero.lead} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://himaltrails.example" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={schemaJson} />

  <!-- Netlify Identity: Loaded conditionally ONLY if an invitation or auth token exists in URL hash -->
  <script is:inline>
    if (window.location.hash && (window.location.hash.includes('token') || window.location.hash.includes('invite'))) {
      const s = document.createElement('script');
      s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      s.async = true;
      s.onload = () => {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', (user) => {
            if (!user) {
              window.netlifyIdentity.on('login', () => {
                document.location.href = '/admin/';
              });
            }
          });
        }
      };
      document.head.appendChild(s);
    }
  </script>
</head>
<body id="top">
  <a class="skip-link" href="#trips">Skip to packages</a>
  <Icons />

  <Header brand={siteData.brand} />

  <main>
    <Hero
      headline={siteData.hero.headline}
      lead={siteData.hero.lead}
      peakName={siteData.hero.peak.name}
      peakMetres={siteData.hero.peak.metres}
      finePrint={siteData.finePrint}
      whatsappUrl={generalWaUrl}
    />

    <section class="sec wrap" id="trips" aria-labelledby="trips-h">
      <div class="packages-header">
        <span class="sec-badge">TOP RATED PACKAGES</span>
        <h2 id="trips-h">Explore Mountain Itineraries</h2>
        <p class="lead">Every package includes private mountain transfers, verified hotel stays, and entry permits.</p>
      </div>

      <!-- Results status bar (Replacing duplicate second filter card) -->
      <div class="results-bar">
        <div class="results-info">
          <span class="count-indicator"></span>
          <span id="count" role="status" aria-live="polite">{trips.length} packages available</span>
          <span id="activeFilterBadge" class="active-filter-badge" hidden></span>
        </div>
        <button type="button" class="btn-reset-filters" id="btnResetFilters" hidden>
          <svg class="i reset-svg" aria-hidden="true"><use href="#i-refresh"/></svg>
          <span>Clear All Filters</span>
        </button>
      </div>

      <div class="empty-state" id="empty" hidden>
        <div class="empty-icon-wrap">
          <svg class="i empty-svg" aria-hidden="true"><use href="#i-compass"/></svg>
        </div>
        <h3>No packages match your search</h3>
        <p>Try widening your duration or budget in the search box above to explore more mountain trips.</p>
        <button type="button" class="btn btn-primary" id="btnResetEmpty">Show All Packages</button>
      </div>

      <div class="grid" id="grid">
        {trips.map((trip, idx) => (
          <TripCard trip={trip} index={idx} />
        ))}
      </div>

      <noscript>
        <p class="fine" style="margin-top:1rem;color:var(--text-muted)">
          Showing all pre-rendered packages. Enable JavaScript for interactive budget filtering and cost estimates.
        </p>
      </noscript>
    </section>

    <BookingAndWhy />

    <Stories stories={storiesData} />

    <Faq faq={faqData} />

    <EnquiryForm phone={siteData.phone} email={siteData.email} />
  </main>

  <Footer brand={siteData.brand} phone={siteData.phone} email={siteData.email} />

  <MobileDock phone={siteData.phone} whatsappUrl={generalWaUrl} />

  <Toast />

  <TripDialog />

  <SavedDialog />

  <!-- Client-side Interactive Logic (No Emojis, Pure SVG Icons) -->
  <script is:inline define:vars={{ trips, siteData }}>
    (() => {
      'use strict';

      const CONFIG = {
        brand: siteData.brand,
        whatsapp: siteData.whatsapp
      };

      // @ts-ignore
      const TRIPS = trips;

      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const fmt = (n) => '\u20B9' + n.toLocaleString('en-IN');
      const formatMetres = (n) => n.toLocaleString('en-IN') + ' m';
      const metres = formatMetres;
      const wa = (msg) => `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(msg)}`;
      const ico = (n) => `<svg class="i" aria-hidden="true"><use href="#i-${n}"/></svg>`;

      const store = {
        get(k, d) {
          try {
            const v = localStorage.getItem(k);
            return v ? JSON.parse(v) : d;
          } catch (e) {
            return d;
          }
        },
        set(k, v) {
          try {
            localStorage.setItem(k, JSON.stringify(v));
          } catch (e) {}
        }
      };

      let toastT;
      function toast(msg) {
        const t = $('#toast');
        if (!t) return;
        t.textContent = msg;
        t.classList.add('show');
        clearTimeout(toastT);
        toastT = setTimeout(() => t.classList.remove('show'), 2200);
      }

      function rng(seed) {
        let s = seed % 2147483647;
        if (s <= 0) s += 2147483646;
        return () => (s = (s * 16807) % 2147483647) / 2147483647;
      }

      function rings({ seed, cx, cy, n, rMax, sx = 1.25, sy = 1, pts = 64, pow = 1.15 }) {
        const r = rng(seed);
        const p = [r() * 6.28, r() * 6.28, r() * 6.28];
        const a = [0.06 + r() * 0.03, 0.04 + r() * 0.02, 0.02 + r() * 0.01];
        const out = [];
        for (let i = 0; i < n; i++) {
          const base = rMax * Math.pow(1 - i / n, pow);
          const line = [];
          for (let k = 0; k <= pts; k++) {
            const th = (k / pts) * Math.PI * 2;
            const w =
              1 +
              a[0] * Math.sin(2 * th + p[0] + i * 0.06) +
              a[1] * Math.sin(3 * th + p[1] - i * 0.05) +
              a[2] * Math.sin(5 * th + p[2] + i * 0.07);
            line.push([cx + Math.cos(th) * base * w * sx, cy + Math.sin(th) * base * w * sy]);
          }
          out.push(line);
        }
        return out;
      }

      const pathOf = (pts) => 'M' + pts.map((p) => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join('L') + 'Z';

      function plate(t, ctx) {
        if (t.photo) {
          return `<img src="${t.photo}" alt="${t.title}" loading="lazy" width="400" height="260" style="width:100%;height:100%;object-fit:cover"/>`;
        }
        const W = 400;
        const H = 260;
        const cx = W * (t.plate.px || 0.5);
        const cy = H * (t.plate.py || 0.5);
        const id = `pg-${ctx}-${t.id}`;
        const R = rings({ seed: t.plate.seed, cx, cy, n: 14, rMax: 230, pts: 64 });
        let s = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${t.plate.bg[0]}"/><stop offset="1" stop-color="${t.plate.bg[1]}"/></linearGradient></defs><rect width="${W}" height="${H}" fill="url(#${id})"/>`;
        R.forEach((line, i) => {
          const hi = i >= R.length - 3;
          const idx = i % 4 === 0;
          s += `<path d="${pathOf(line)}" fill="none" stroke="${hi ? '#FFB400' : '#90CDF4'}" stroke-opacity="${hi ? (0.65 + (i - (R.length - 3)) * 0.15).toFixed(2) : idx ? 0.5 : 0.25}" stroke-width="${hi ? 1.5 : idx ? 1.3 : 1}" stroke-linejoin="round"/>`;
        });
        s += `<path d="M${cx},${cy - 7}l6,11h-12z" fill="#FFB400"/><text x="${cx + 12}" y="${cy + 4}" fill="#fff" font-size="13" font-weight="700" paint-order="stroke" stroke="#0E1A2B" stroke-width="5" stroke-linejoin="round">${metres(t.highestPointMetres)}</text></svg>`;
        return s;
      }

      /* ==========================================================
         FILTERS & PACKAGES
         ========================================================= */
      const state = { dest: 'All', dur: 'any', max: 35000 };
      const durOk = (n) =>
        state.dur === 'any' ||
        (state.dur === 'short' && n <= 3) ||
        (state.dur === 'mid' && n >= 4 && n <= 5) ||
        (state.dur === 'long' && n >= 6);

      let saved = new Set(store.get('ht_saved', []));

      function cardHTML(t, i) {
        const altPercent = Math.min(100, (t.highestPointMetres / 5000) * 100);
        const daysCount = t.nights + 1;
        const originalPrice = Math.round((t.pricePerPerson * 1.2) / 500) * 500;
        const savings = originalPrice - t.pricePerPerson;

        return `<article class="package-card${t.featured ? ' featured-deal' : ''}" style="--i:${i}; --p:${altPercent}%" data-id="${t.id}">
          <div class="card-media">
            ${plate(t, 'c')}
            <div class="media-overlay-top">
              ${
                t.tag
                  ? `<span class="badge-tag deal-flame"><svg class="i badge-svg" aria-hidden="true"><use href="#i-sparkle"/></svg><span>${t.tag.toUpperCase()}</span></span>`
                  : `<span class="badge-tag rating-star"><svg class="i badge-svg star-icon" aria-hidden="true"><use href="#i-star"/></svg><span>4.9 (120+)</span></span>`
              }
              <button class="heart-circle" data-save="${t.id}" aria-pressed="${saved.has(t.id)}" aria-label="Save ${t.title}">${ico('heart')}</button>
            </div>
            <div class="media-overlay-bottom">
              <span class="alt-chip"><svg class="i chip-svg" aria-hidden="true"><use href="#i-mountain"/></svg><span>${formatMetres(t.highestPointMetres)}</span></span>
              <span class="duration-chip">${t.nights}N / ${daysCount}D</span>
            </div>
          </div>
          <div class="card-content">
            <div class="dest-row">
              <span class="dest-badge"><svg class="i pin-svg" aria-hidden="true"><use href="#i-pin"/></svg><span>${t.destination}</span></span>
              <span class="cancellation-badge">Free Date Change</span>
            </div>
            <h3 class="package-title">${t.title}</h3>
            <div class="amenities-row">
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-home"/></svg><span>Stay</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-car"/></svg><span>Private Cab</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-utensils"/></svg><span>Meals</span></span>
              <span class="amenity-chip"><svg class="i amen-svg" aria-hidden="true"><use href="#i-ticket"/></svg><span>Permits</span></span>
            </div>
            <ul class="highlights-list">
              ${t.highlights.slice(0, 3).map((h) => `<li>${h}</li>`).join('')}
            </ul>
            <div class="card-footer">
              <div class="price-block">
                <div class="mrp-row">
                  <span class="mrp">${fmt(originalPrice)}</span>
                  <span class="save-tag">SAVE ${fmt(savings)}</span>
                </div>
                <div class="deal-price-row">
                  <strong class="deal-price">${fmt(t.pricePerPerson)}</strong>
                  <span class="per-person">/ person</span>
                </div>
              </div>
              <div class="action-buttons">
                <button class="btn btn-primary view-btn" data-open="${t.id}">View Deal</button>
              </div>
            </div>
          </div>
        </article>`;
      }

      const destOk = (t) => {
        if (state.dest === 'All') return true;
        const d = state.dest.toLowerCase();
        const td = (t.destination || '').toLowerCase();
        const tt = (t.title || '').toLowerCase();
        return td.includes(d) || tt.includes(d);
      };

      function renderTrips() {
        const list = TRIPS.filter(
          (t) => destOk(t) && durOk(t.nights) && t.pricePerPerson <= state.max
        );
        $('#grid').innerHTML = list.map(cardHTML).join('');

        if ($('#count')) {
          $('#count').textContent = list.length
            ? `${list.length} package${list.length > 1 ? 's' : ''} available`
            : '0 packages match';
        }
        if ($('#empty')) {
          $('#empty').hidden = list.length > 0;
        }

        const hasFilter = state.dest !== 'All' || state.dur !== 'any' || state.max < 35000;
        const resetBtn = $('#btnResetFilters');
        const badge = $('#activeFilterBadge');
        if (resetBtn) resetBtn.hidden = !hasFilter;
        if (badge) {
          if (hasFilter) {
            const parts = [];
            if (state.dest !== 'All') parts.push(state.dest);
            if (state.dur === 'short') parts.push('2-3 Nights');
            if (state.dur === 'mid') parts.push('4-5 Nights');
            if (state.dur === 'long') parts.push('6+ Nights');
            if (state.max < 35000) parts.push(`Up to ${fmt(state.max)}`);
            badge.textContent = `Filtered: ${parts.join(' • ')}`;
            badge.hidden = false;
          } else {
            badge.hidden = true;
          }
        }

        updateSearchCardUI();
      }

      function updateSearchCardUI() {
        // Destination field value and subtitle
        const destMeta = {
          All: { val: 'All Destinations', sub: 'Darjeeling, Gangtok, Pelling & more' },
          Darjeeling: { val: 'Darjeeling', sub: 'Tiger Hill Sunrise, Toy Train, Chowrasta' },
          Sikkim: { val: 'Sikkim', sub: 'Gangtok, Tsomgo Lake, Pelling & more' },
          'North Sikkim': { val: 'North Sikkim', sub: 'Gurudongmar Lake, Lachen, Yumthang' },
          Kalimpong: { val: 'Kalimpong & Homestays', sub: 'Pine trails, Lamahatta, quiet homestays' },
          Gangtok: { val: 'Gangtok & East Sikkim', sub: 'Tsomgo Lake, Nathula Pass, MG Marg' },
          Pelling: { val: 'West Sikkim & Pelling', sub: 'Glass Skywalk, Rabdentse, Buddha Park' }
        };
        const curDest = destMeta[state.dest] || { val: state.dest, sub: 'Explore handcrafted mountain tours' };
        if ($('#heroDestVal')) $('#heroDestVal').textContent = curDest.val;
        if ($('#heroDestSub')) $('#heroDestSub').textContent = curDest.sub;

        $$('#dropdownDest .dropdown-item').forEach((item) => {
          const match = item.dataset.dest === state.dest;
          item.classList.toggle('active', match);
          item.setAttribute('aria-selected', String(match));
        });

        // Duration field
        const durLabels = {
          any: { title: 'Any Length', sub: 'Weekend 2N to Grand 6N+' },
          short: { title: 'Weekend (2–3N)', sub: 'Quick getaways & short escapes' },
          mid: { title: 'Popular (4–5N)', sub: 'Standard family & couple trips' },
          long: { title: 'Expedition (6N+)', sub: 'In-depth mountain explorations' }
        };
        const curDur = durLabels[state.dur] || durLabels.any;
        if ($('#heroDurVal')) $('#heroDurVal').textContent = curDur.title;
        if ($('#heroDurSub')) $('#heroDurSub').textContent = curDur.sub;
        $$('#dropdownDur .dropdown-item').forEach((item) => {
          const match = item.dataset.dur === state.dur;
          item.classList.toggle('active', match);
          item.setAttribute('aria-selected', String(match));
        });

        // Budget field
        if ($('#heroBudgetVal')) {
          $('#heroBudgetVal').textContent = state.max >= 35000 ? 'Flexible' : 'Up to ' + fmt(state.max);
        }
        if ($('#heroBudgetSub')) {
          $('#heroBudgetSub').textContent = state.max >= 35000 ? 'From ₹7,500 to ₹35,000+' : `Packages within ${fmt(state.max)}`;
        }
        $$('#dropdownBudget .dropdown-item').forEach((item) => {
          const bVal = Number(item.dataset.budget);
          const match = state.max === bVal || (state.max >= 35000 && bVal >= 35000);
          item.classList.toggle('active', match);
          item.setAttribute('aria-selected', String(match));
        });

        // Tabs - activate only the single exact matching tab
        function getMatchingTab(dest) {
          if (!dest || dest === 'All') return 'All';
          const d = dest.toLowerCase();
          if (d.includes('north sikkim')) return 'North Sikkim';
          if (d.includes('sikkim') || d.includes('gangtok') || d.includes('pelling')) return 'Sikkim';
          if (d.includes('darjeeling')) return 'Darjeeling';
          if (d.includes('kalimpong') || d.includes('homestay')) return 'Kalimpong';
          return 'All';
        }

        const activeTabKey = getMatchingTab(state.dest);
        $$('.search-tab').forEach((tab) => {
          const match = tab.dataset.destPick === activeTabKey;
          tab.classList.toggle('active', match);
          tab.setAttribute('aria-selected', String(match));
        });

        // Popular pills
        $$('.mini-pill').forEach((pill) => {
          const pillDest = pill.dataset.quickDest;
          const match = state.dest.toLowerCase().includes(pillDest.toLowerCase());
          pill.classList.toggle('active', match);
        });
      }

      function setDestination(dest) {
        state.dest = dest;
        renderTrips();
      }

      function resetFilters() {
        state.dest = 'All';
        state.dur = 'any';
        state.max = 35000;
        renderTrips();
      }

      /* ==========================================================
         SAVED TRIPS SHORTLIST
         ========================================================== */
      function syncSaved() {
        $$('[data-save]').forEach((b) => b.setAttribute('aria-pressed', saved.has(b.dataset.save)));
        ['#dockCount', '#hdrCount'].forEach((sel) => {
          const el = $(sel);
          if (el) {
            el.textContent = saved.size;
            el.hidden = saved.size === 0;
          }
        });
        if ($('#savedDlg') && $('#savedDlg').open) renderSaved();
      }

      function toggleSave(id) {
        const t = TRIPS.find((x) => x.id === id);
        if (!t) return;
        if (saved.has(id)) {
          saved.delete(id);
          toast('Removed from saved shortlist');
        } else {
          saved.add(id);
          toast(`Saved ${t.title} to shortlist`);
        }
        store.set('ht_saved', [...saved]);
        syncSaved();
      }

      function renderSaved() {
        const list = [...saved].map((id) => TRIPS.find((t) => t.id === id)).filter(Boolean);
        const msg = `Hi ${CONFIG.brand}! I'm shortlisting these packages: ${list.map((t) => t.title).join(', ')}. Can you help me plan?`;
        $('#savedBody').innerHTML =
          `<div class="sv"><h2>My Shortlist</h2>` +
          (list.length
            ? `<ul class="sv-list">${list
                .map(
                  (t) =>
                    `<li><div><strong>${t.title}</strong><span>${t.nights} nights, from ${fmt(t.pricePerPerson)}</span></div><div class="sv-act"><button class="link" data-open="${t.id}">View</button><button class="link" data-save="${t.id}">Remove</button></div></li>`
                )
                .join('')}</ul><a class="btn btn-whatsapp" target="_blank" rel="noopener" href="${wa(msg)}">${ico('chat')}Send Shortlist on WhatsApp</a>`
            : `<p class="muted" style="margin-bottom:1.5rem">No packages saved yet. Tap the heart on any card to save it here, then send your shortlist in one WhatsApp message.</p><a class="btn btn-primary" href="#trips" data-close>Browse Packages</a>`) +
          `</div>`;
      }

      /* ==========================================================
         TRIP DIALOG & ESTIMATOR
         ========================================================== */
      const tripDlg = $('#tripDlg');
      const savedDlg = $('#savedDlg');
      let current = null;
      let est = { n: 2, rooms: 1 };

      function tripHTML(t) {
        return `<button class="x" data-close aria-label="Close">${ico('x')}</button>
        <div class="sheet-plate">${plate(t, 'd')}
          <button class="heart-circle" data-save="${t.id}" aria-pressed="${saved.has(t.id)}" aria-label="Save ${t.title}">${ico('heart')}</button>
          <div class="sheet-title">
            <p>${t.destination} • ${t.nights} Nights / ${t.nights + 1} Days</p>
            <h2 id="tripTitle">${t.title}</h2>
          </div>
        </div>
        <div class="sheet-grid">
          <div class="sheet-main">
            <h3>Day-by-Day Itinerary</h3>
            <div class="acc">${t.days
              .map(
                (d, i) =>
                  `<details${i === 0 ? ' open' : ''}><summary><span class="dn">${d.label}</span><span class="dt">${d.title}</span>${ico('chev')}</summary><p>${d.text}</p></details>`
              )
              .join('')}</div>
            <h3>What's Included</h3>
            <ul class="inc">${t.included.map((x) => `<li>${ico('check')}<span>${x}</span></li>`).join('')}</ul>
          </div>
          <aside class="est" aria-label="Trip estimate">
            <h3>Estimate Package Cost</h3>
            <div class="est-row">
              <div class="est-row-label">
                <span id="lblTrav" style="font-weight:700">Number of Travellers</span>
                <small style="color:var(--text-muted);display:block;font-size:0.75rem">How many people?</small>
              </div>
              <div class="stepper" role="group" aria-labelledby="lblTrav">
                <button type="button" data-step-trav="-1" aria-label="Fewer travellers">${ico('minus')}</button>
                <output id="estN" aria-live="polite">${est.n}</output>
                <button type="button" data-step-trav="1" aria-label="More travellers">${ico('plus')}</button>
              </div>
            </div>
            <div class="est-row">
              <div class="est-row-label">
                <span id="lblRooms" style="font-weight:700">Number of Rooms</span>
                <small style="color:var(--text-muted);display:block;font-size:0.75rem">How many rooms needed?</small>
              </div>
              <div class="stepper" role="group" aria-labelledby="lblRooms">
                <button type="button" data-step-room="-1" aria-label="Fewer rooms">${ico('minus')}</button>
                <output id="estRooms" aria-live="polite">${est.rooms}</output>
                <button type="button" data-step-room="1" aria-label="More rooms">${ico('plus')}</button>
              </div>
            </div>
            <div class="est-total">
              <span>Estimated Total (Twin Sharing)</span>
              <strong id="estTotal"></strong>
              <small id="estPer"></small>
            </div>
            <a class="btn btn-whatsapp" id="estWa" target="_blank" rel="noopener">${ico('chat')}Get Exact Quote on WhatsApp</a>
            <p class="fine">Indicative quote. Final rate depends on travel dates and room availability.</p>
          </aside>
        </div>`;
      }

      function updateEst() {
        const t = current;
        if (!t) return;
        const per = t.pricePerPerson;
        const total = per * est.n;
        const nEl = $('#estN');
        const rEl = $('#estRooms');
        const totEl = $('#estTotal');
        const perEl = $('#estPer');
        const waEl = $('#estWa');

        if (nEl) nEl.textContent = est.n;
        if (rEl) rEl.textContent = est.rooms;
        if (totEl) totEl.textContent = fmt(total);
        if (perEl) {
          perEl.textContent = `${fmt(per)} per person • ${est.n} Guest${est.n > 1 ? 's' : ''}, ${est.rooms} Room${est.rooms > 1 ? 's' : ''}`;
        }
        if (waEl) {
          waEl.href = wa(
            `Hi ${CONFIG.brand}! I'm interested in the "${t.title}" package for ${est.n} traveller${est.n > 1 ? 's' : ''} and ${est.rooms} room${est.rooms > 1 ? 's' : ''}. Could you share availability and the final quote?`
          );
        }
        $$('[data-step-trav]', tripDlg).forEach((b) => {
          const step = Number(b.dataset.stepTrav);
          b.disabled = (step === -1 && est.n <= 1) || (step === 1 && est.n >= 16);
        });
        $$('[data-step-room]', tripDlg).forEach((b) => {
          const step = Number(b.dataset.stepRoom);
          b.disabled = (step === -1 && est.rooms <= 1) || (step === 1 && (est.rooms >= est.n || est.rooms >= 8));
        });
      }

      function openTrip(id) {
        current = TRIPS.find((t) => t.id === id);
        if (!current) return;
        est = { n: 2, rooms: 1 };
        $('#tripBody').innerHTML = tripHTML(current);
        updateEst();
        document.body.classList.add('lock');
        if (!tripDlg.open) tripDlg.showModal();
        tripDlg.scrollTop = 0;
      }

      function openSaved() {
        renderSaved();
        document.body.classList.add('lock');
        savedDlg.showModal();
      }

      /* ==========================================================
         EVENT LISTENERS & DELEGATION
         ========================================================== */
      document.addEventListener('click', (e) => {
        const o = e.target.closest('[data-open]');
        if (o) {
          if (savedDlg.open) savedDlg.close();
          openTrip(o.dataset.open);
          return;
        }
        const sv = e.target.closest('[data-save]');
        if (sv) {
          toggleSave(sv.dataset.save);
          return;
        }
        const stTrav = e.target.closest('[data-step-trav]');
        if (stTrav) {
          const delta = Number(stTrav.dataset.stepTrav);
          est.n = Math.min(16, Math.max(1, est.n + delta));
          if (est.rooms < Math.ceil(est.n / 3)) {
            est.rooms = Math.ceil(est.n / 3);
          }
          if (est.rooms > est.n) {
            est.rooms = est.n;
          }
          updateEst();
          return;
        }
        const stRoom = e.target.closest('[data-step-room]');
        if (stRoom) {
          const delta = Number(stRoom.dataset.stepRoom);
          est.rooms = Math.min(est.n, Math.min(8, Math.max(1, est.rooms + delta)));
          updateEst();
          return;
        }
        const c = e.target.closest('[data-close]');
        if (c) {
          const d = c.closest('dialog');
          if (d) d.close();
        }

        // Hero Search Tabs click
        const tab = e.target.closest('[data-dest-pick]');
        if (tab) {
          closeAllDropdowns();
          setDestination(tab.dataset.destPick);
          return;
        }

        // Hero quick pills
        const qPill = e.target.closest('[data-quick-dest]');
        if (qPill) {
          closeAllDropdowns();
          setDestination(qPill.dataset.quickDest);
          document.getElementById('trips')?.scrollIntoView({ behavior: 'smooth' });
          return;
        }

        // Dropdown item selection inside Hero search card
        const dItem = e.target.closest('.dropdown-item');
        if (dItem) {
          if (dItem.dataset.dest !== undefined) {
            state.dest = dItem.dataset.dest;
          } else if (dItem.dataset.dur !== undefined) {
            state.dur = dItem.dataset.dur;
          } else if (dItem.dataset.budget !== undefined) {
            state.max = Number(dItem.dataset.budget);
          }
          closeAllDropdowns();
          renderTrips();
          return;
        }

        // Hero field box toggle
        const fBox = e.target.closest('.field-box');
        if (fBox) {
          const wasOpen = fBox.classList.contains('open');
          closeAllDropdowns();
          if (!wasOpen) {
            fBox.classList.add('open');
            fBox.setAttribute('aria-expanded', 'true');
            const dd = fBox.querySelector('.field-dropdown');
            if (dd) dd.hidden = false;
          }
          return;
        }

        // Clicking outside any field box or dropdown closes all dropdowns
        closeAllDropdowns();
      });

      function closeAllDropdowns() {
        $$('.field-box').forEach((box) => {
          box.classList.remove('open');
          box.setAttribute('aria-expanded', 'false');
          const dd = box.querySelector('.field-dropdown');
          if (dd) dd.hidden = true;
        });
      }

      // Keyboard support for field boxes (Enter / Space to toggle)
      $$('.field-box').forEach((box) => {
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const wasOpen = box.classList.contains('open');
            closeAllDropdowns();
            if (!wasOpen) {
              box.classList.add('open');
              box.setAttribute('aria-expanded', 'true');
              const dd = box.querySelector('.field-dropdown');
              if (dd) {
                dd.hidden = false;
                dd.querySelector('button')?.focus();
              }
            }
          }
        });
      });

      // Search Holidays CTA button
      $('#heroSearchTrigger')?.addEventListener('click', (e) => {
        e.preventDefault();
        closeAllDropdowns();
        renderTrips();
        const tripsEl = document.getElementById('trips');
        if (tripsEl) {
          const yOffset = -72;
          const y = tripsEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });

      // Reset filters from results status bar or empty state
      $('#btnResetFilters')?.addEventListener('click', resetFilters);
      $('#btnResetEmpty')?.addEventListener('click', resetFilters);

      [tripDlg, savedDlg].forEach((d) => {
        d.addEventListener('click', (e) => {
          if (e.target === d) d.close();
        });
        d.addEventListener('close', () => {
          if (!tripDlg.open && !savedDlg.open) document.body.classList.remove('lock');
        });
      });

      $('#dockSaved')?.addEventListener('click', openSaved);
      $('#hdrSaved')?.addEventListener('click', openSaved);

      // Mobile dock navigation active state
      $('#dockHome')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        $('#dockHome')?.classList.add('active');
        $('#dockTrips')?.classList.remove('active');
      });

      $('#dockTrips')?.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('trips')?.scrollIntoView({ behavior: 'smooth' });
        $('#dockTrips')?.classList.add('active');
        $('#dockHome')?.classList.remove('active');
      });

      const tripsSec = document.getElementById('trips');
      if (tripsSec && 'IntersectionObserver' in window) {
        const dockObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                $('#dockTrips')?.classList.add('active');
                $('#dockHome')?.classList.remove('active');
              } else if (window.scrollY < 300) {
                $('#dockHome')?.classList.add('active');
                $('#dockTrips')?.classList.remove('active');
              }
            });
          },
          { threshold: 0.2 }
        );
        dockObs.observe(tripsSec);
      }

      /* Mobile menu toggle */
      const nav = $('#nav');
      const menuBtn = $('#menuBtn');

      function setMenu(open) {
        nav?.classList.toggle('open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        const icon = $('#menuIcon');
        if (icon) {
          icon.innerHTML = `<use href="#i-${open ? 'x' : 'menu'}"/>`;
        }
        document.body.classList.toggle('lock', open);
      }

      menuBtn?.addEventListener('click', () => setMenu(!nav?.classList.contains('open')));
      nav?.addEventListener('click', (e) => {
        if (e.target.closest('a')) setMenu(false);
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('open')) setMenu(false);
      });

      /* Dynamic month generator (next 7 months) */
      const mSel = $('#fMonth');
      if (mSel) {
        const now = new Date();
        for (let i = 0; i < 7; i++) {
          const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
          const opt = document.createElement('option');
          opt.value = d.toLocaleString('en-IN', { month: 'long', year: 'numeric' });
          opt.textContent = opt.value;
          mSel.appendChild(opt);
        }
      }

      /* Enquiry form submit handler */
      $('#form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const f = new FormData(e.target);
        const name = String(f.get('name') || '').trim();
        const n = Math.max(1, Number(f.get('n')) || 1);
        const month = String(f.get('month') || 'Not sure yet');
        const note = String(f.get('note') || '').trim();
        const msgEl = $('#formMsg');

        if (!name) {
          if (msgEl) {
            msgEl.textContent = 'Please enter your name.';
            msgEl.classList.remove('success');
          }
          e.target.elements.name?.focus();
          return;
        }

        const savedList = [...saved]
          .map((id) => TRIPS.find((t) => t.id === id))
          .filter(Boolean)
          .map((t) => t.title);

        let msg = `Hi ${CONFIG.brand}! I'm ${name}. We are planning a mountain trip for ${n} traveller${n > 1 ? 's' : ''}, thinking of ${month}.`;
        if (savedList.length) msg += ` Shortlisted packages: ${savedList.join(', ')}.`;
        if (note) msg += ` Note: ${note}`;

        if (msgEl) {
          msgEl.textContent = 'Opening WhatsApp with your holiday inquiry...';
          msgEl.classList.add('success');
        }
        window.open(wa(msg), '_blank', 'noopener');
      });

      /* Initialize */
      renderTrips();
      syncSaved();
    })();
  </script>
</body>
</html>

